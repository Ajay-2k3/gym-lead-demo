# Digits only, including country code. Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Optional. Leave blank to keep the free local demo mode.
# Add a Google Apps Script, Make, Zapier, Formspree, or custom JSON endpoint later.
NEXT_PUBLIC_LEAD_ENDPOINT=

# Set this to the final production origin so social preview URLs are absolute.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
